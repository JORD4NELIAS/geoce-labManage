# ==============================================================================
# GEOCE LabManage — Regras Estritas de Segurança (.gitignore)
# ==============================================================================

# 1. Dependências e Gerenciadores de Pacote
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# 2. Instaladores e Binários Locais Pesados (Irrelevantes para o repositório)
/instalacao/
*.msi
*.exe
*.dmg
*.pkg
*.zip
*.tar.gz
*.tgz
*.rar
*.7z

# 3. Chaves, Tokens e Credenciais Privadas (SEGURANÇA CRÍTICA - NUNCA COMMITAR)
.env
.env*
!.env.example
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.token
tokens.json
credentials.json
service-account*.json
service_role*.json
.secrets
secrets/
private/

# 4. Saídas de Build e Compilação
/.next/
/out/
/build/
/dist/
*.tsbuildinfo
next-env.d.ts

# 5. Logs e Depuração
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# 6. Dumps, Backups Locais e Scratchpad Privado
scratch/
dumps/
dump/
temp/
tmp/
.temp/
.tmp/
.cache/
*.dump
*.sql.bak
*.bak
*.backup
*.sqlite
*.sqlite3
*.db

# 7. Plataformas de Deploy (Vercel)
.vercel/

# 8. Metadados de Sistema Operacional, IDEs e IA
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.antigravity/
.gemini/

